#!/bin/bash
# Script to stop the local development server

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PID_FILE="$PROJECT_DIR/.server.pid"

if [ ! -f "$PID_FILE" ]; then
    echo "PID file not found ($PID_FILE). Is the server stopped?"
    exit 1
fi

PID=$(cat "$PID_FILE")

if ps -p "$PID" > /dev/null 2>&1; then
    echo "Stopping server with PID $PID..."
    kill "$PID"
    
    # Wait a moment to verify that it stopped
    for i in {1..5}; do
        if ! ps -p "$PID" > /dev/null 2>&1; then
            break
        fi
        sleep 0.5
    done
    
    if ps -p "$PID" > /dev/null 2>&1; then
        echo "The server did not respond to standard termination. Forcing shutdown..."
        kill -9 "$PID"
    fi
    
    echo "Server stopped successfully."
else
    echo "The server with PID $PID is not running."
fi

rm "$PID_FILE"
